# ===== 站点 =====
# 自己的绑定域名（不带结尾斜杠）。OIDC 回调、登出跳转都按它拼接，必须与实际访问域名一致
SITE_URL=https://exam.example.com
# 站点名称，显示在浏览器标题、顶部导航与首页
SITE_NAME=通用单选题考试系统
# Logo 文字（1~2 个字符，取站点名首字或缩写）
SITE_LOGO=考
# 主题色，十六进制，如 #0f5fff；按钮、链接、Logo 都跟着变
BRAND_COLOR="#0f5fff"

# ===== 登录认证（腾讯统一身份认证 OneID，OIDC）=====
OIDC_ISSUER=https://oauth2.account.tencent.com/authz/oidc/v2/1492474500942414067
OIDC_CLIENT_ID=你的客户端ID
OIDC_CLIENT_SECRET=你的客户端密钥
# 客户端认证方式：basic（默认，走 Authorization 头）或 post（凭据放表单）
# 留空则先试 basic，OneID 回 invalid_client 时自动改试 post
OIDC_CLIENT_AUTH_METHOD=
# 需要的 scope，多个用空格分隔
OIDC_SCOPES=openid profile
# 登出后回跳地址，必须是 OneID 应用里登记过的那个；留空则回站点首页
OIDC_LOGOUT_REDIRECT_URI=https://exam.example.com/logout-done

# 会话签名密钥，建议用随机长字符串（openssl rand -hex 32）；不填则回退使用 OIDC_CLIENT_SECRET
SESSION_SECRET=

# ===== 考试规则 =====
# 每场抽题数量（题库不足时按题库实际数量出卷）
EXAM_QUESTION_COUNT=10
# 每题分值，满分 = 抽题数量 × 每题分值
EXAM_POINTS_PER_QUESTION=10
# 及格分
EXAM_PASS_SCORE=60
# 考试时长（分钟），到时自动交卷
EXAM_DURATION_MINUTES=30
# 每人最多考试次数，0 或留空表示不限
EXAM_MAX_ATTEMPTS=0
# 考试截止时间，按北京时间解析，如 2026-12-31 23:59；留空表示不限
EXAM_DEADLINE=

# ===== 展示开关 =====
# 是否公开成绩排名（false 时隐藏入口，/api/ranking 也会拒绝）
EXAM_SHOW_RANKING=true
# 交卷后是否展示正确答案与逐题对错（false 时只给分数和你的作答）
EXAM_SHOW_ANSWER=true
# 是否把答题记录写入 KV（false 时不留记录、不参与排名，只返回本次成绩）
EXAM_KEEP_RECORDS=true

# ===== 管理后台白名单 =====
# 逗号分隔，可填 OneID 的 preferred_username / email / mobile / sub（大小写不敏感）
ADMIN_USERS=admin@example.com,zhangsan

# ===== KV 绑定变量名 =====
# 在 EdgeOne 控制台「项目 → KV 存储 → 绑定命名空间」时填写的变量名。
# 注意：它是运行时全局变量（EXAM_KV.get(...)），不是环境变量，不要写进项目环境变量里。
KV_BINDING=EXAM_KV
